# The release whose seeded generators produce these vendors' exports.
#
# ONE PLACE. `scripts/fixtures.py` installs the wheels by URL at this tag, so
# the version cannot be written twice and drift -- the tag IS the URL.
#
# This is what makes two platforms comparable: contoso-fabric-platform and
# contoso-airflow-data-product pull from the same vendor bytes because both
# consume this repo, and this repo names one release.
FABRIC_EMULATOR_VERSION=0.28.0

# The simulator that serves the OpenAPI vendors. Pinned HERE rather than in a
# platform, because it is part of what "the vendor" means: mokapi's behaviour
# is the vendor's behaviour, and two consumers on different mokapis are not
# pulling from the same vendor even if the specs match.
MOKAPI_VERSION=0.50.0
